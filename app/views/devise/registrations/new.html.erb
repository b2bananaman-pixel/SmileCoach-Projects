
<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="card shadow-sm p-4">

        <h2 class="text-center mb-3">新規登録</h2>
        <p class="text-center text-muted mb-4" data-invitation-signup-note>管理者からの招待で登録します。</p>

        <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
          <%= render "devise/shared/error_messages", resource: resource %>

          <div class="mb-3">
            <%= f.label :name, "名前", class: "form-label" %>
            <%= f.text_field :name, autofocus: true, class: "form-control" %>
          </div>

          <div class="mb-3">
            <%= f.label :email, "メールアドレス", class: "form-label" %>
            <%# 招待先のメールアドレスで登録する（送信された値はサーバー側で使わない） %>
            <%= f.email_field :email, readonly: true, autocomplete: "email", class: "form-control-plaintext",
                                      aria: { describedby: "invitation-email-help" }, data: { invitation_email: true } %>
            <div id="invitation-email-help" class="form-text">招待されたメールアドレスで登録します（変更できません）。</div>
          </div>

          <div class="mb-3">
            <%= f.label :password, "パスワード", class: "form-label" %>
            <% if @minimum_password_length %>
              <div class="form-text">
                <%= @minimum_password_length %>文字以上
              </div>
            <% end %>
            <%= f.password_field :password, autocomplete: "new-password", class: "form-control" %>
          </div>

          <div class="mb-4">
            <%= f.label :password_confirmation, "パスワード（確認）", class: "form-label" %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control" %>
          </div>

          <div class="d-grid">
            <%= f.submit "新規登録", class: "btn btn-secondary" %>
          </div>
        <% end %>

        <div class="text-center mt-3">
          <%= render "devise/shared/links" %>
        </div>

      </div>
    </div>
  </div>
</div>

