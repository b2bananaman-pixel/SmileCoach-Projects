<div class="container py-5">
  <h1 class="text-center mb-2">AIロープレ評価結果</h1>

  <p class="text-center text-muted mb-5">
    練習テーマ：<%= @ai_roleplay_session.practice_theme.name %>
  </p>

  <div class="row justify-content-center">
    <div class="col-md-8">

      <% if @ai_roleplay_evaluation.present? %>
        <div class="card shadow-sm mb-4">
          <div class="card-body">
            <h2 class="h4 mb-4">評価項目</h2>

            <% AiRoleplayEvaluation::CATEGORY_LABELS.each_with_index do |(category, label), index| %>
              <div
                class="border rounded p-3 <%= index == AiRoleplayEvaluation::CATEGORY_LABELS.size - 1 ? "mb-0" : "mb-3" %>"
                data-ai-roleplay-evaluation-category="<%= category %>"
              >
                <div class="row g-2 align-items-center">
                  <div class="col-12 col-sm-4">
                    <h3 class="h5 mb-0"><%= label %></h3>
                  </div>

                  <% if @ai_roleplay_evaluation.evaluated?(category) %>
                    <div class="col-3 col-sm-2 fw-bold text-nowrap" data-ai-roleplay-evaluation-points>
                      <%= @ai_roleplay_evaluation.points_for(category) %>点
                    </div>

                    <div
                      class="col-6 col-sm-4 text-warning text-nowrap"
                      data-ai-roleplay-evaluation-stars
                      aria-label="5段階中<%= @ai_roleplay_evaluation.score_for(category) %>"
                    >
                      <%= @ai_roleplay_evaluation.stars_for(category) %>
                    </div>

                    <div class="col-3 col-sm-2 fs-5" data-ai-roleplay-evaluation-face aria-hidden="true">
                      <%= @ai_roleplay_evaluation.face_for(category) %>
                    </div>
                  <% else %>
                    <div class="col-12 col-sm-8 text-muted" data-ai-roleplay-evaluation-not-applicable>
                      評価対象外
                    </div>
                  <% end %>
                </div>

                <% if @ai_roleplay_evaluation.evaluated?(category) %>
                  <% good_point = @ai_roleplay_evaluation.good_point_for(category) %>
                  <% improvement_point = @ai_roleplay_evaluation.improvement_point_for(category) %>

                  <% if good_point.present? %>
                    <div class="mt-3">
                      <p class="fw-bold mb-1">良かった点</p>
                      <p class="mb-0"><%= good_point %></p>
                    </div>
                  <% end %>

                  <% if improvement_point.present? %>
                    <div class="mt-3">
                      <p class="fw-bold mb-1">改善点</p>
                      <p class="mb-0"><%= improvement_point %></p>
                    </div>
                  <% end %>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>

        <div class="card shadow-sm mb-4">
          <div class="card-body">
            <h2 class="h4 mb-3">総合的な強み</h2>

            <p class="mb-0">
              <%= @ai_roleplay_evaluation.overall_strength %>
            </p>
          </div>
        </div>

        <div class="card shadow-sm mb-4">
          <div class="card-body">
            <h2 class="h4 mb-3">優先して改善する点</h2>

            <p class="mb-0">
              <%= @ai_roleplay_evaluation.priority_improvement %>
            </p>
          </div>
        </div>

        <div class="card shadow-sm mb-4">
          <div class="card-body">
            <h2 class="h4 mb-3">次回の練習目標</h2>

            <p class="mb-0">
              <%= @ai_roleplay_evaluation.next_practice_goal %>
            </p>
          </div>
        </div>
      <% else %>
        <div class="card shadow-sm mb-4 text-center">
          <div class="card-body py-4">
            <p class="mb-2">
              このロープレの評価結果はありません。
            </p>

            <p class="text-muted mb-4">
              評価の作成に失敗したか、評価できる会話がありませんでした。もう一度ロープレに挑戦してみましょう。
            </p>

            <%= link_to "練習テーマへ戻る",
                        practice_theme_path(@ai_roleplay_session.practice_theme),
                        class: "btn btn-primary" %>
          </div>
        </div>
      <% end %>

      <div class="card shadow-sm mb-4" data-ai-roleplay-voice-analysis>
        <div class="card-body">
          <h2 class="h4 mb-2">話し方の分析（参考）</h2>

          <p class="text-muted small mb-4">
            あなたの発話音声から分析した参考値です。接客内容の評価とは別に、項目ごとに表示しています。
          </p>

          <% if @voice_analysis.present? %>
            <div class="border rounded p-3 mb-3" data-ai-roleplay-voice-analysis-item="speech_speed">
              <div class="d-flex justify-content-between align-items-center">
                <h3 class="h5 mb-0">話速</h3>
                <span class="fw-bold" data-ai-roleplay-voice-analysis-score>
                  <%= @voice_analysis.speech_speed_score.nil? ? "-" : "#{@voice_analysis.speech_speed_score}点" %>
                </span>
              </div>

              <p class="mb-0 mt-2" data-ai-roleplay-voice-analysis-value>
                <%= number_with_precision(@voice_analysis.speech_speed, precision: 2) %> 文字/秒
              </p>
            </div>

            <div class="border rounded p-3 mb-3" data-ai-roleplay-voice-analysis-item="filler">
              <div class="d-flex justify-content-between align-items-center">
                <h3 class="h5 mb-0">フィラー</h3>
                <span class="fw-bold" data-ai-roleplay-voice-analysis-score>
                  <%= @voice_analysis.filler_score.nil? ? "-" : "#{@voice_analysis.filler_score}点" %>
                </span>
              </div>

              <p class="mb-0 mt-2" data-ai-roleplay-voice-analysis-value>
                フィラー回数：<%= @voice_analysis.filler_count %>回
              </p>
            </div>

            <div class="border rounded p-3" data-ai-roleplay-voice-analysis-item="volume">
              <div class="d-flex justify-content-between align-items-center">
                <h3 class="h5 mb-0">声量</h3>
                <span class="fw-bold" data-ai-roleplay-voice-analysis-score>
                  <%= @voice_analysis.volume_score.nil? ? "-" : "#{@voice_analysis.volume_score}点" %>
                </span>
              </div>

              <p class="mb-0 mt-2" data-ai-roleplay-voice-analysis-value>
                声量：<%= number_with_precision(@voice_analysis.volume, precision: 1) %> dB
              </p>
            </div>

            <% if @voice_analysis.ai_comment.present? %>
              <div class="mt-4" data-ai-roleplay-voice-analysis-advice>
                <p class="fw-bold mb-1">改善アドバイス</p>
                <p class="mb-0"><%= @voice_analysis.ai_comment %></p>
              </div>
            <% end %>
          <% else %>
            <p class="mb-0 text-muted" data-ai-roleplay-voice-analysis-empty>
              話し方の分析結果はありません
            </p>
          <% end %>
        </div>
      </div>

    </div>
  </div>
</div>
