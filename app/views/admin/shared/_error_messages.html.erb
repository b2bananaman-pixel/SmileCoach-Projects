<% if record.errors.any? %>
  <div class="alert alert-danger" role="alert" data-admin-form-errors>
    <p class="mb-2"><%= record.errors.count %>件のエラーがあるため、保存できませんでした。</p>
    <ul class="mb-0">
      <% record.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
