<div class="container py-5">
  <p class="mb-4">
    <%= link_to practice_categories_path, class: "text-decoration-none", data: { back_to_categories: true } do %>
      <i class="bi bi-chevron-left" aria-hidden="true"></i>
      カテゴリ一覧へ戻る
    <% end %>
  </p>

  <h1 class="text-center mb-3"><%= @practice_category.name %></h1>
  <p class="text-center text-muted mb-5">練習する商材を選んで、AIロープレを始めましょう。</p>

  <% if @products.empty? %>
    <div class="alert alert-light border text-center" data-practice-category-empty>
      現在、このカテゴリの練習は準備中です
    </div>
  <% else %>
    <div class="row g-4 justify-content-center">
      <% @products.each do |product| %>
        <div class="col-md-6 col-lg-4">
          <div class="card h-100 shadow-sm" data-practice-product="<%= product.id %>">
            <div class="card-body d-flex flex-column">
              <h2 class="card-title h5 mb-1">
                <%= product.name %>
              </h2>

              <% if product.maker.present? %>
                <p class="text-muted small mb-2"><%= product.maker %></p>
              <% end %>

              <p class="card-text mb-3"><%= truncate(product.summary, length: 120) %></p>

              <%= link_to "この商材でAIロープレを始める",
                          product_ai_roleplay_path(product),
                          class: "btn btn-success mt-auto" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
