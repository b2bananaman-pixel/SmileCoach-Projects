<script
  src="https://cdn.jsdelivr.net/npm/@mediapipe/selfie_segmentation/selfie_segmentation.js"
  crossorigin="anonymous">
</script>

<div class="container py-5">
  <h1 class="text-center mb-5">接客練習</h1>

  <div class="row justify-content-center">
    <div class="col-md-8">

      <div class="card shadow-sm mb-4">
        <div class="card-body">
          <h2 class="card-title mb-4">
            練習テーマ：<%= @practice_theme.name %>
          </h2>

          <div class="border rounded p-3 mb-4">
            <h3 class="h5 mb-3">👤 お客様像</h3>
            <p class="card-text mb-0">
              <%= simple_format(
                @practice_theme.description.split("接客条件：").first.sub("お客様像：", "")
              ) %>
            </p>
          </div>

          <div class="border rounded p-3">
            <h3 class="h5 mb-3">🎯 今回の接客ポイント</h3>
            <p class="card-text mb-0">
              <%= simple_format(
                @practice_theme.description.split("接客条件：").last
              ) %>
            </p>
          </div>
        </div>
      </div>

      <div
        class="card shadow-sm text-center"
        data-controller="video-background"
        data-video-background-create-url-value="<%= create_practice_practice_theme_path(@practice_theme) %>"
      >
        <div class="card-body py-4">

          <h2 class="h5 mb-3">背景を選択</h2>

          <div class="mb-4">
            <button
              type="button"
              data-video-background-target="backgroundButton"
              data-background="none"
              data-action="click->video-background#selectBackground"
              aria-pressed="true"
              class="btn btn-outline-secondary me-2">
              背景なし
            </button>

            <button
              type="button"
              data-video-background-target="backgroundButton"
              data-background="office1"
              data-background-url="<%= asset_path('office1.jpg') %>"
              data-action="click->video-background#selectBackground"
              aria-pressed="false"
              class="btn btn-outline-secondary me-2">
              オフィス①
            </button>

            <button
              type="button"
              data-video-background-target="backgroundButton"
              data-background="office2"
              data-background-url="<%= asset_path('office2.jpg') %>"
              data-action="click->video-background#selectBackground"
              aria-pressed="false"
              class="btn btn-outline-secondary me-2">
              オフィス②
            </button>

            <button
              type="button"
              data-video-background-target="backgroundButton"
              data-background="simple"
              data-background-url="<%= asset_path('simple.jpg') %>"
              data-action="click->video-background#selectBackground"
              aria-pressed="false"
              class="btn btn-outline-secondary">
              シンプル
            </button>
          </div>

          <div class="mb-4">
            <div
              class="mx-auto"
              style="
                width: 100%;
                max-width: 640px;
              "
            >
              <video
                data-video-background-target="sourceVideo"
                class="d-none"
                autoplay
                muted
                playsinline>
              </video>

              <canvas
                data-video-background-target="preview"
                class="w-100 rounded">
              </canvas>
            </div>
          </div>

          <h2 class="h5 mb-3">録画状態</h2>

          <p
            id="recording-status"
            data-video-background-target="status"
            class="mb-4">
            起動中...
          </p>

          <button
            id="start-recording"
            type="button"
            data-video-background-target="startButton"
            data-action="click->video-background#startRecording"
            class="btn btn-primary me-2"
            disabled>
            録画開始
          </button>

          <button
            id="stop-recording"
            type="button"
            data-video-background-target="stopButton"
            data-action="click->video-background#stopRecording"
            class="btn btn-secondary"
            disabled>
            録画停止
          </button>

        </div>
      </div>

    </div>
  </div>
</div>