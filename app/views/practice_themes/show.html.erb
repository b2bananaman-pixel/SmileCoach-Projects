<div class="container py-5">
  <h1 class="text-center mb-5">接客練習</h1>

  <div class="row justify-content-center">
    <div class="col-md-8">

      <div class="card shadow-sm mb-4">
        <div class="card-body">
          <h2 class="card-title mb-4">
            練習テーマ：<%= @practice_theme.name %>
          </h2>

          <div class="border rounded p-3 mb-4">
            <h3 class="h5 mb-3">👤 お客様像</h3>

            <p class="card-text mb-0">
              <%= simple_format(
                @practice_theme.description.split("接客条件：").first.sub("お客様像：", "")
              ) %>
            </p>
          </div>

          <div class="border rounded p-3">
            <h3 class="h5 mb-3">🎯 今回の接客ポイント</h3>

            <p class="card-text mb-0">
              <%= simple_format(
                @practice_theme.description.split("接客条件：").last
              ) %>
            </p>
          </div>
        </div>
      </div>

      <div class="card shadow-sm text-center">
        <div class="card-body py-4">

          <h2 class="h5 mb-3">録画状態</h2>

          <p id="recording-status" class="mb-4">
            停止中
          </p>

          <button id="start-recording"
                  class="btn btn-primary me-2">
            録画開始
          </button>

          <button id="stop-recording"
                  class="btn btn-secondary"
                  disabled>
            録画停止
          </button>

        </div>
      </div>

    </div>
  </div>
</div>

<script>
  document.addEventListener("turbo:load", () => {
    const startButton = document.getElementById("start-recording");
    const stopButton = document.getElementById("stop-recording");
    const status = document.getElementById("recording-status");

    if (!startButton || !stopButton || !status) return;

    startButton.addEventListener("click", () => {
      status.textContent = "録画中";
      startButton.disabled = true;
      stopButton.disabled = false;
    });

    stopButton.addEventListener("click", () => {
      status.textContent = "停止中";
      startButton.disabled = false;
      stopButton.disabled = true;
    });
  });
</script>