# Ignore bundler config.
/.bundle

# Ignore the default directory of bundled gems.
/vendor/bundle

# Ignore project specific Ruby files
/.ruby-version
/.ruby-gemset

# Ignore Rails master key.
/config/master.key

# Ignore credentials.
/config/credentials/*.key

# Ignore log files.
/log/*
!/log/.keep

# Ignore temporary files.
/tmp/*
!/tmp/.keep

# Ignore storage files.
/storage/*
!/storage/.keep

# Ignore uploaded files.
/public/uploads

# Ignore compiled assets.
/public/assets

# Ignore CSS/JS build files.
/app/assets/builds/*
!/app/assets/builds/.keep

# Ignore Node.js dependencies.
/node_modules/

# Ignore coverage reports.
/coverage/

# Ignore environment variables
.env
.env.*

# Ignore macOS files
.DS_Store

# Ignore editor files
.vscode/
.idea/